# ===== 로컬 도구/환경 =====
.claude/
.omc/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.idea/
.vscode/

# ===== OS =====
.DS_Store
Thumbs.db

# ===== 비밀/키 (절대 커밋 금지) =====
.env
.env.*
*.key
*_secret*

# ===== 실데이터 / 개인정보(PII) — 조사표 원본·추출 결과는 절대 커밋 금지 =====
# (확장자 통째로 차단해 미래 파일도 실수로 올라가지 않게 함)
*.hwpx
*.hwp
*.pdf
*.xlsx
*.xls

# ===== 런타임 생성물(데이터·캐시·업로드·출력) =====
data/
field-survey-db/data/

# ===== 발표자료 산출물(대용량) — 소스(make_*.py/js, *.dc.html)만 커밋 =====
slides/node_modules/
slides/autodata-slides.html
*.pptx

# ===== 포터블 빌드 산출물(용량 큼 — 커밋 금지) =====
build/
dist/
*.log
build_*.txt
field-survey-db/build/
field-survey-db/dist/
field-survey-db/build_*.txt

# ===== 테스트 픽스처(실데이터 포함) =====
**/tests/fixtures/*.hwpx
**/tests/fixtures/*.pdf

# ===== eval 골드/리포트(값에 실데이터 PII 포함 — 로컬만) =====
field-survey-db/eval/gold/
field-survey-db/eval/REPORT.md

# ===== AI 프록시 설정(앱 토큰 포함 — 커밋 금지, 예시 파일만 커밋) =====
ai_config.txt
**/ai_config.txt

# ===== AI 설정창 저장파일(암호화된 API 키 — 커밋 금지) =====
ai_settings.enc
**/ai_settings.enc

# 디지털 입력 양식 로컬 설정
forms_config.txt
field-survey-db/forms_config.txt

# wrangler dev 로컬 상태
.wrangler/

# 설명서·예제 생성물(원고 docs/manual.md 와 그림 docs/manual_img 만 커밋)
field-survey-db/examples/
field-survey-db/docs/오토다타_사용설명서.*

# 설명서 HTML 은 web/manual.html 한 벌만 커밋(앱은 web/ 에서 읽음)
field-survey-db/static/manual.html
